model ContentSection {
  id          Int      @id @default(autoincrement())
  sectionName String   @unique
  banner      String?
  title       String?
  description String?  @db.Text
  images      String[]
  // Contenido estructurado para las secciones que no entran en
  // title/description/images: listas de ítems con varios campos cada uno
  // (personajes con imagen+cursor+nombre, testimonios, aliados). Las
  // secciones simples lo dejan en null. Cada editor del panel define su forma.
  data        Json?
  isActive    Boolean  @default(true)
  // Borrador pendiente de publicar: foto completa de {title, description,
  // banner, images, data, isActive}. Cada guardado del panel escribe acá, no
  // en las columnas vivas de arriba; "publish" copia este objeto a esas
  // columnas y lo deja en null. null = no hay cambios pendientes.
  draft       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("content_sections")
}

// Biblioteca de medios central. Cada archivo subido a /uploads se registra
// aquí como un recurso propio, reutilizable en varias secciones o
// habitaciones. La columna `path` ("/uploads/<archivo>") es la clave de
// unión: ContentSection.banner / ContentSection.images / Room.photoUrl
// guardan ese mismo string, no el id.
//
// Borrado lógico: borrar una sección NUNCA toca los archivos. Eliminar un
// recurso desde la biblioteca solo marca `deletedAt` (papelera) y deja el
// archivo en disco; se puede restaurar. La purga real (borrar el archivo
// del disco) queda para una fase posterior.

model MediaAsset {
  id           Int       @id @default(autoincrement())
  filename     String
  path         String    @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  alt          String?
  folder       String    @default("general")
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([folder])
  @@index([deletedAt])
  @@map("media_assets")
}
