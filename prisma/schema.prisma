generator client {
  provider     = "prisma-client"
  output       = "../backend/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  // Canal por el que llegó el contacto: "whatsapp" (canal principal del
  // formulario) o "email". En el flujo WhatsApp el visitante igual llena todos
  // sus datos, así que se registran aquí además de abrir wa.me.
  channel   String   @default("email")
  status    String   @default("pendiente")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  passwordHash        String
  name                String
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  userRoles           UserRole[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// Token de un solo uso para "recuperar contraseña". Nunca se guarda el token
// en claro: la fila lleva su hash SHA-256 y el enlace del correo lleva el
// valor original. Un token vale 1 hora y se marca `usedAt` al gastarlo.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  code            String           @unique
  description     String?
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id     Int  @id @default(autoincrement())
  userId Int
  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Installation {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("installations")
}

model Room {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  capacity      Int      @default(2)
  pricePerNight Decimal  @db.Decimal(10, 2)
  photoUrl      String
  status        String   @default("active")
  type          String   @default("standard")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reservations Reservation[]

  @@map("rooms")
}

model Customer {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  phone     String?
  document  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]

  @@map("customers")
}

// Nota: la tabla "reservations" tiene además una columna generada
// "dateRange" y una restricción EXCLUDE (GiST) que impide dos reservas
// cruzadas para la misma habitación, agregadas en la migración
// 20260825140000_reservation_no_overlap_constraint. La migración
// 20260828160000_reservation_overlap_ignores_completed la ajustó para que
// solo apliquen los estados PENDIENTE y CONFIRMADA (una reserva COMPLETADA
// o CANCELADA ya no ocupa el calendario). Prisma no puede declarar ese tipo
// de restricción en este schema, así que vive solo en el SQL de la
// migración — no la borres si algún día regeneras el schema desde la BD.

model Reservation {
  id            Int      @id @default(autoincrement())
  roomId        Int
  customerId    Int
  checkIn       DateTime
  checkOut      DateTime
  totalPrice    Decimal  @db.Decimal(10, 2)
  status        String   @default("PENDIENTE")
  guests        String?
  message       String?  @db.Text
  preferredTime String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  room     Room     @relation(fields: [roomId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@map("reservations")
}

