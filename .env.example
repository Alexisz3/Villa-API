DATABASE_URL="postgresql://postgres:changeme@localhost:5432/villa_db?schema=public"
JWT_SECRET=replace-with-a-long-random-secret
PORT=3001

# Used by docker-compose.yml for variable substitution (api + db services)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=villa_db

# Comma-separated list of allowed origins when NODE_ENV=production (leave unset to block all cross-origin requests)
CORS_ORIGINS=https://villaanamaria.com

# Only used once, the first time `prisma db seed` creates the admin user
# (never used again after that — the seed won't touch the password of an
# admin that already exists). Set this to a real strong password before
# seeding a fresh database; do not commit a real value here.
ADMIN_SEED_PASSWORD=replace-with-a-strong-password
